# ── Portfolio Backend — Environment Variables ──
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/portfolio
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/portfolio
MONGO_URI=mongodb://localhost:27017/portfolio

# Redis (Optional — app works without it)
# Render:  redis://<user>:<pass>@<host>:<port>
# Upstash: rediss://default:<pass>@<host>:<port>
# Docker:  redis://redis:6379
REDIS_URL=

# CORS — Frontend URL
CLIENT_URL=http://localhost:5173

# ── Email (Nodemailer) ──
# Your Gmail address
EMAIL_USER=pritishpanda157@gmail.com
# Gmail App Password (NOT your Gmail login password)
# Steps to generate:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already done
#   3. Search "App passwords" in the search bar
#   4. Select "Mail" + device, click Generate
#   5. Copy the 16-character password here (no spaces)
EMAIL_PASS=your_gmail_app_password_here

# ── OpenAI (Optional) ──
# If provided, the AI assistant will use GPT-4o-mini instead of local RAG
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
